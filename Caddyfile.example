memos.your.domian {
	reverse_proxy /api/v1/* http://your:port
	reverse_proxy /o/r/* http://your:port
	reverse_proxy http://your:port
}

artalk.your.domian {
	reverse_proxy http://your:port
}

.your.domian {
	root * /var/www/.your.domian
	encode gzip

	# Optional: avoid opening the detail shell without a memo id.
	redir /memos / permanent
	redir /memos/ / permanent

	# Serve memo detail pages from the static detail entry.
	# Example: /memos/4AbosJuC6GhrbkXhi3r2GH -> /memos/index.html
	handle /memos/* {
		try_files {path} /memos/index.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	@static {
		path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.webp *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000"

	@html {
		path / *.html
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	handle {
		file_server
	}
}

www..your.domian {
	redir https://.your.domian{uri} permanent
}
